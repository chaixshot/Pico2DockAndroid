<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:visibility="visible"
    tools:context=".MainActivity"
    tools:visibility="visible">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="fill_parent"
        app:cardBackgroundColor="@color/main_bg"
        app:cardCornerRadius="32dp"
        app:contentPadding="10dp"
        tools:ignore="MissingConstraints">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="10dp"
            android:orientation="vertical"
            android:visibility="visible">

            <androidx.cardview.widget.CardView
                android:id="@+id/CardBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/card_bg"
                app:cardCornerRadius="10dp"
                app:contentPaddingBottom="10dp"
                app:contentPaddingLeft="24dp"
                app:contentPaddingRight="24dp"
                app:contentPaddingTop="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:visibility="visible">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <ImageView
                                    android:id="@+id/imageView2"
                                    android:layout_width="27dp"
                                    android:layout_height="27dp"
                                    app:srcCompat="@mipmap/ic_launcher_round" />

                                <TextView
                                    android:id="@+id/textView3"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginLeft="10dp"
                                    android:text="@string/app_name"
                                    android:textSize="20sp"
                                    android:textStyle="bold" />

                            </LinearLayout>

                            <TextView
                                android:id="@+id/textView4"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/app_description" />

                            <TextView
                                android:id="@+id/textView5"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/multitasking_desc" />

                        </LinearLayout>

                        <FrameLayout
                            android:layout_width="fill_parent"
                            android:layout_height="match_parent">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:layout_gravity="end"
                                android:gravity="fill"
                                android:orientation="horizontal">

                                <Button
                                    android:id="@+id/ButtonLanguage"
                                    android:layout_width="32dp"
                                    android:layout_height="40dp"
                                    android:onClick="ButtonLanguagePickerOpen"
                                    android:tooltipText="@string/language_picker_title"
                                    app:icon="@android:drawable/ic_menu_manage"
                                    app:iconGravity="textStart"
                                    app:iconPadding="0dp" />

                                <Button
                                    android:id="@+id/ButtonHelp"
                                    android:layout_width="32dp"
                                    android:layout_height="40dp"
                                    android:layout_marginLeft="5dp"
                                    android:onClick="ButtonHelpOpen"
                                    android:padding="0dp"
                                    android:tooltipText="@string/help_message"
                                    app:icon="@android:drawable/ic_dialog_info"
                                    app:iconGravity="textStart"
                                    app:iconPadding="0dp" />
                            </LinearLayout>
                        </FrameLayout>

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginTop="2dp"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="fill_parent"
                            android:gravity="bottom"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/textView7"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:enabled="false"
                                android:text="@string/too_large_warning"
                                android:textSize="12sp"
                                android:visibility="visible" />

                            <TextView
                                android:id="@+id/textView"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:enabled="false"
                                android:text="@string/pico_optimize_hint"
                                android:textSize="12sp"
                                android:visibility="visible" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/textView6"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/made_by"
                                android:textSize="14sp" />

                            <Button
                                android:id="@+id/button"
                                android:layout_width="wrap_content"
                                android:layout_height="40dp"
                                android:layout_marginLeft="10dp"
                                android:onClick="OpenGithubPage"
                                android:paddingTop="0dp"
                                android:paddingBottom="0dp"
                                android:text="@string/github_page"
                                android:tooltipText="@string/github_tooltip"
                                app:cornerRadius="10dp" />
                        </LinearLayout>
                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/CardFiles"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:layout_marginTop="5dp"
                android:backgroundTint="@color/card_bg"
                app:cardCornerRadius="10dp">

                <ListView
                    android:id="@+id/ListViewFiles"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                </ListView>

                <TextView
                    android:id="@+id/TextFileSelectHint"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:onClick="SelectFile"
                    android:text="@string/select_file_hint"
                    android:textSize="24sp"
                    android:tooltipText="@string/select_file_tooltip" />
            </androidx.cardview.widget.CardView>

            <LinearLayout
                android:id="@+id/ControlBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/ButtonStart"
                            android:layout_width="100dp"
                            android:layout_height="40dp"
                            android:enabled="false"
                            android:onClick="ButtonStartPressed"
                            android:paddingTop="0dp"
                            android:paddingBottom="0dp"
                            android:text="@string/button_start"
                            android:tooltipText="@string/button_start_tooltip"
                            app:cornerRadius="10dp" />

                        <Button
                            android:id="@+id/ButtonClear"
                            android:layout_width="100dp"
                            android:layout_height="40dp"
                            android:layout_marginLeft="5dp"
                            android:enabled="false"
                            android:onClick="ButtonClearPressed"
                            android:paddingTop="0dp"
                            android:paddingBottom="0dp"
                            android:text="@string/button_clear"
                            android:tooltipText="@string/button_clear_tooltip"
                            app:cornerRadius="10dp" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/ButtonCancel"
                            android:layout_width="100dp"
                            android:layout_height="40dp"
                            android:enabled="false"
                            android:maxWidth="300dp"
                            android:onClick="ButtonCancelPressed"
                            android:paddingTop="0dp"
                            android:paddingBottom="0dp"
                            android:text="@string/button_cancel"
                            android:tooltipText="@string/button_cancel_tooltip"
                            app:cornerRadius="10dp" />

                        <Button
                            android:id="@+id/ButtonBattery"
                            android:layout_width="32dp"
                            android:layout_height="40dp"
                            android:layout_marginLeft="5dp"
                            android:contentDescription="@string/battery_optimization_desc"
                            android:onClick="RequestBatteryOptimization"
                            android:tooltipText="@string/battery_optimization_tooltip"
                            app:icon="@android:drawable/ic_lock_idle_charging"
                            app:iconGravity="textStart"
                            app:iconPadding="0dp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:gravity="end"
                    android:orientation="horizontal">

                    <androidx.cardview.widget.CardView
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:backgroundTint="@color/card_bg"
                        app:cardCornerRadius="10dp"
                        app:contentPaddingLeft="20dp"
                        app:contentPaddingRight="20dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical">

                            <Switch
                                android:id="@+id/SwitchHideDock"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_weight="0"
                                android:paddingTop="10dp"
                                android:text="@string/hide_dock"
                                android:tooltipText="@string/hide_dock_tooltip" />

                            <Switch
                                android:id="@+id/FinishSound"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_weight="0"
                                android:checked="true"
                                android:paddingTop="10dp"
                                android:text="@string/finish_sound"
                                android:tooltipText="@string/finish_sound_tooltip" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_marginLeft="5dp"
                        android:backgroundTint="@color/card_bg"
                        app:cardCornerRadius="10dp"
                        app:contentPaddingLeft="20dp"
                        app:contentPaddingRight="20dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical">

                            <CheckBox
                                android:id="@+id/CheckboxRePackage"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="-5dp"
                                android:layout_marginBottom="-5dp"
                                android:text="@string/new_package_name"
                                android:tooltipText="@string/new_package_name_tooltip" />

                            <CheckBox
                                android:id="@+id/CheckboxRePackageAdv"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="-5dp"
                                android:layout_marginBottom="-5dp"
                                android:text="@string/advance_mode"
                                android:tooltipText="@string/advance_mode_tooltip" />
                        </LinearLayout>

                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="5dp"
                        android:backgroundTint="@color/card_bg"
                        app:cardCornerRadius="10dp"
                        app:contentPaddingLeft="20dp"
                        app:contentPaddingRight="20dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical">

                            <EditText
                                android:id="@+id/TextRename"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="-4dp"
                                android:layout_marginBottom="-4dp"
                                android:layout_weight="1"
                                android:ems="10"
                                android:hint="@string/after_app_name_hint"
                                android:inputType="text"
                                android:textSize="16sp"
                                android:tooltipText="@string/after_app_name_tooltip" />

                            <CheckBox
                                android:id="@+id/CheckboxRename"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="-3dp"
                                android:layout_marginTop="-3dp"
                                android:layout_marginBottom="-3dp"
                                android:text="@string/rename_label"
                                android:tooltipText="@string/rename_tooltip" />
                        </LinearLayout>

                    </androidx.cardview.widget.CardView>

                </LinearLayout>

            </LinearLayout>

            <androidx.cardview.widget.CardView
                android:id="@+id/CardStatus"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="5dp"
                android:backgroundTint="@color/card_bg"
                app:cardCornerRadius="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="-4dp">

                        <ProgressBar
                            android:id="@+id/StatusProgressBar"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_gravity="center"
                            android:progress="40"
                            android:scaleY="3" />

                        <TextView
                            android:id="@+id/PercentText"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginTop="1dp"
                            android:gravity="center"
                            android:text="40%"
                            android:textColor="@color/white"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/StatusText"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginLeft="24dp"
                        android:layout_marginRight="24dp" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>